"""
Entry point. Run with:  python main.py
"""

import logging
import sys

from telegram.ext import ApplicationBuilder

import config
import storage
import telegram_bot

logging.basicConfig(
    format="%(asctime)s %(levelname)s [%(name)s] %(message)s",
    level=logging.INFO,
)
log = logging.getLogger("topup-bot")


def main():
    problems = config.validate()
    if problems:
        for p in problems:
            log.error("Config problem: %s", p)
        sys.exit(1)

    storage.init_db()
    log.info("DB ready at %s", config.DB_PATH)
    log.info("Reloadly mode: %s", "SANDBOX" if config.RELOADLY_SANDBOX else "LIVE")

    app = ApplicationBuilder().token(config.TELEGRAM_TOKEN).build()
    for handler in telegram_bot.build_handlers():
        app.add_handler(handler)

    log.info("Bot starting (polling)…")
    app.run_polling(drop_pending_updates=True)


if __name__ == "__main__":
    main()
