"""
Thin, dependency-light wrapper around Reloadly's Airtime API.

Auth is OAuth2 client-credentials: we mint a bearer token against
auth.reloadly.com and cache it until just before expiry. Production
tokens last 60 days, sandbox tokens 24 hours, so caching matters.
"""

import time
import logging
import requests

import config

log = logging.getLogger(__name__)


class ReloadlyError(Exception):
    """Raised when Reloadly returns an error we can't recover from."""


class ReloadlyClient:
    def __init__(self):
        self._token: str | None = None
        self._token_expiry: float = 0.0  # epoch seconds

    # --- auth -------------------------------------------------------------
    def _get_token(self) -> str:
        """Return a valid bearer token, refreshing if needed."""
        if self._token and time.time() < self._token_expiry - 60:
            return self._token

        payload = {
            "client_id": config.RELOADLY_CLIENT_ID,
            "client_secret": config.RELOADLY_CLIENT_SECRET,
            "grant_type": "client_credentials",
            "audience": config.TOPUPS_AUDIENCE,
        }
        resp = requests.post(
            config.AUTH_URL,
            json=payload,
            headers={"Content-Type": "application/json"},
            timeout=20,
        )
        if resp.status_code != 200:
            raise ReloadlyError(f"Auth failed ({resp.status_code}): {resp.text}")

        data = resp.json()
        self._token = data["access_token"]
        # expires_in is in seconds; default to 1h if Reloadly omits it.
        self._token_expiry = time.time() + int(data.get("expires_in", 3600))
        log.info("Reloadly token refreshed; valid for %ss", data.get("expires_in"))
        return self._token

    def _headers(self) -> dict:
        return {
            "Authorization": f"Bearer {self._get_token()}",
            "Accept": config.TOPUPS_ACCEPT,
            "Content-Type": "application/json",
        }

    def _get(self, path: str, params: dict | None = None) -> dict | list:
        resp = requests.get(
            f"{config.TOPUPS_BASE}{path}",
            headers=self._headers(),
            params=params,
            timeout=30,
        )
        if resp.status_code >= 400:
            raise ReloadlyError(f"GET {path} -> {resp.status_code}: {resp.text}")
        return resp.json()

    # --- account ----------------------------------------------------------
    def get_balance(self) -> dict:
        """Your Reloadly float: {'balance': float, 'currencyCode': 'GBP', ...}."""
        return self._get("/accounts/balance")

    # --- operators --------------------------------------------------------
    def autodetect_operator(self, phone: str, iso2: str) -> dict:
        """
        Resolve the mobile operator for a number so we top up the right network.
        `phone` should be the local/national number (no '+', no country code).
        """
        return self._get(
            f"/operators/auto-detect/phone/{phone}/countries/{iso2}",
            params={"suggestedAmountsMap": "false"},
        )

    def get_operator(self, operator_id: int) -> dict:
        """Full operator record: FX rate, min/max amounts, currencies."""
        return self._get(f"/operators/{operator_id}")

    # --- the money move ---------------------------------------------------
    def send_topup(
        self,
        operator_id: int,
        amount: float,
        recipient_country_code: str,
        recipient_number: str,
        custom_identifier: str,
        use_local_amount: bool = False,
    ) -> dict:
        """
        Execute a top-up.

        `amount` is in YOUR wallet currency (GBP) when use_local_amount is False.
        That GBP figure is your wholesale cost — your retail price is computed
        in pricing.py and collected from the customer separately.
        """
        body = {
            "operatorId": operator_id,
            "amount": amount,
            "useLocalAmount": use_local_amount,
            "customIdentifier": custom_identifier,
            "recipientPhone": {
                "countryCode": recipient_country_code,
                "number": recipient_number,
            },
        }
        resp = requests.post(
            f"{config.TOPUPS_BASE}/topups",
            headers=self._headers(),
            json=body,
            timeout=60,
        )
        if resp.status_code >= 400:
            raise ReloadlyError(f"Top-up failed ({resp.status_code}): {resp.text}")
        return resp.json()

    def get_transaction(self, transaction_id: int) -> dict:
        return self._get(f"/topups/{transaction_id}")
